{
  "name": "ai-lead-qualification-load-sim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production load simulation for the AI lead qualification pipeline: queue, rate limits, retries, dead letters, metrics and cost tracking.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx scripts/demo.ts",
    "replay": "tsx scripts/replay.ts",
    "simulate": "tsx scripts/simulate.ts",
    "sim:10k": "tsx scripts/simulate.ts --leads 10000 --concurrency 50"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "openai": "^6.9.0",
    "pino": "^10.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
