# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Shared secret required in the `x-webhook-secret` header. GoHighLevel custom
# webhooks let you add static headers — use one. Leave empty for local demo.
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Providers — `fake` runs the whole pipeline with no accounts and no network.
# ---------------------------------------------------------------------------
LLM_PROVIDER=fake            # fake | claude
CRM_PROVIDER=fake            # fake | ghl

# ---------------------------------------------------------------------------
# Claude
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Classification is a cheap, high-volume task; effort is set to `low` in code.
CLAUDE_MODEL=claude-opus-5
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2
# Server-side refusal fallback. Harmless for B2B lead text, but if your account
# lacks the beta, set this to false rather than editing code.
CLAUDE_REFUSAL_FALLBACK=true
CLAUDE_FALLBACK_MODEL=claude-opus-4-8

# ---------------------------------------------------------------------------
# GoHighLevel (Private Integration token, scopes: contacts.readonly/write)
# ---------------------------------------------------------------------------
GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

# ---------------------------------------------------------------------------
# Routing thresholds — see docs/decisions.md
# ---------------------------------------------------------------------------
HOT_SCORE_THRESHOLD=80
WARM_SCORE_THRESHOLD=50
# A route is only taken if the model is also confident enough to justify it.
HOT_CONFIDENCE_THRESHOLD=0.8
WARM_CONFIDENCE_THRESHOLD=0.7
BLOCKED_EMAIL_DOMAINS=competitor.com,example-spam.io

# How long a processed GHL event id is remembered, to collapse redeliveries.
IDEMPOTENCY_TTL_MINUTES=1440
