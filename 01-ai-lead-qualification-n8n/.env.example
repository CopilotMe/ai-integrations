# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Shared secret required in the `x-webhook-secret` header on POST /v1/*.
# Leave empty to disable auth (local demo only).
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Providers — set each to `fake` to run the whole pipeline with zero accounts.
# ---------------------------------------------------------------------------
LLM_PROVIDER=fake            # fake | openai
CRM_PROVIDER=fake            # fake | hubspot
NOTIFIER_PROVIDER=fake       # fake | slack

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# HubSpot (Private App token, scopes: crm.objects.contacts.*, crm.objects.deals.*)
# ---------------------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=default
HUBSPOT_DEAL_STAGE_HOT=appointmentscheduled
HUBSPOT_DEAL_STAGE_WARM=qualifiedtobuy

# ---------------------------------------------------------------------------
# Slack (Incoming Webhook URL)
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
SLACK_NOTIFY_ON=HOT,WARM     # comma-separated classifications

# ---------------------------------------------------------------------------
# Business rules — see docs/architecture.md#scoring
# ---------------------------------------------------------------------------
HOT_SCORE_THRESHOLD=75
WARM_SCORE_THRESHOLD=45
MIN_QUALIFIED_BUDGET_EUR=5000
HIGH_BUDGET_EUR=25000
BLOCKED_EMAIL_DOMAINS=competitor.com,example-spam.io
