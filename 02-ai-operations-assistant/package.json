{
  "name": "ai-operations-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "AI operations assistant: inbound email → LLM classification → autonomy policy → human approval → execution, with a full audit trail.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d && node scripts/wait-for-db.mjs",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "docker compose down -v && npm run db:up && npm run db:migrate && npm run db:seed",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@types/pg": "^8.15.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.7",
    "next": "^15.5.7",
    "openai": "^6.9.0",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "drizzle-kit": "^0.31.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
