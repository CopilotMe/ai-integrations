# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local (npm run db:up):
DATABASE_URL=postgresql://ops:ops@localhost:5432/ai_ops
# Supabase / Neon: use the POOLED connection string, not the direct one.
# DATABASE_URL=postgresql://user:pass@host:6543/postgres?pgbouncer=true
DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs admin session cookies. Generate: openssl rand -base64 48
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Providers — `fake` runs the whole system with no accounts and no network.
# ---------------------------------------------------------------------------
LLM_PROVIDER=fake            # fake | openai
TICKETING_PROVIDER=fake      # fake | http
NOTIFIER_PROVIDER=fake       # fake | slack

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2

TICKETING_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Autonomy policy — see docs/autonomy-policy.md
# ---------------------------------------------------------------------------
POLICY_THRESHOLD_NONE=0.5
POLICY_THRESHOLD_LOW=0.75
POLICY_THRESHOLD_MEDIUM=0.9
# Above 1 means "never automatic". Refunds/cancellations always reach a human.
POLICY_THRESHOLD_HIGH=1.01
POLICY_MIN_CONFIDENCE=0.4
POLICY_REFUND_AUTO_CAP_EUR=0
POLICY_VIP_DOMAINS=
POLICY_ALWAYS_REVIEW_INTENTS=complaint,cancellation

LOG_LEVEL=info
